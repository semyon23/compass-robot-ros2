<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>vda5050_ros2</name>
  <version>0.1.0</version>
  <description>Агент VDA 5050 v3 на роботе: связь с fms по MQTT, state из compass_core, езда по order'ам через Nav2</description>
  <maintainer email="semen@example.com">semen</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>rclcpp_action</depend>
  <depend>nav_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>robot_interfaces</depend>
  <depend>nlohmann-json-dev</depend>
  <!-- apt: libpaho-mqttpp-dev (paho-mqtt-cpp 1.2) -->
  <depend>libpaho-mqttpp-dev</depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
