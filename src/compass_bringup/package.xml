<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>compass_bringup</name>
  <version>0.1.0</version>
  <description>Запуск сервисной части робота: compass_core, twist_mux, rosbridge; симуляция TB4 для разработки</description>
  <maintainer email="semen@example.com">semen</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>compass_core</exec_depend>
  <exec_depend>twist_mux</exec_depend>
  <exec_depend>rosbridge_server</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>task_orchestrator_core</exec_depend>
  <exec_depend>lifecycle_msgs</exec_depend>
  <exec_depend>nav2_minimal_tb4_sim</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
