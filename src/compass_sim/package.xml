  <description>Разработка без робота: TurtleBot4 в Gazebo + сервисная часть Compass. На робот не ставится.</description>
  <maintainer email="semen@example.com">semen</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

