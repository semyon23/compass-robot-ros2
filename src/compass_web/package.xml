<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>compass_web</name>
  <version>0.1.0</version>
  <description>Веб-сервер Compass на роботе: статика UI, файлы карт и логов, прокси WebSocket к rosbridge (вместо nginx)</description>
  <maintainer email="semen@example.com">semen</maintainer>
  <license>Proprietary</license>

  <exec_depend>rclpy</exec_depend>
  <!-- Tornado уже стоит как зависимость rosbridge_server -->
  <exec_depend>python3-tornado</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
